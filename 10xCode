#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORK_DIR="$PWD"
INSTR="$SCRIPT_DIR/initial_instructions.md"
SESSION="10x_$(basename "$WORK_DIR")"
N=2

# Parse --N flag (e.g. --8, --10)
for arg in "$@"; do
    if [[ "$arg" =~ ^--([0-9]+)$ ]]; then
        N="${BASH_REMATCH[1]}"
    fi
done

# Write a temp script that will run inside the new Terminal window
SETUP="/tmp/10xcode_${SESSION}.sh"
cat > "$SETUP" << SETUP_EOF
#!/bin/bash
tmux kill-session -t "$SESSION" 2>/dev/null || true
tmux new-session -s "$SESSION" -c "$WORK_DIR"

for i in \$(seq 1 $((N-1))); do
    tmux split-window -d -t "$SESSION" -c "$WORK_DIR"
done

if [ $N -eq 2 ]; then
    tmux select-layout -t "$SESSION" even-vertical
elif [ $N -gt 2 ]; then
    tmux select-layout -t "$SESSION" tiled
fi

for i in \$(seq 0 $((N-1))); do
    tmux send-keys -t "$SESSION:0.\$i" "claude < \"$INSTR\"" Enter
done

tmux attach-session -t "$SESSION"
SETUP_EOF
chmod +x "$SETUP"

# Open a new fullscreen Terminal window and run the setup inside it
osascript << APPLESCRIPT
tell application "Finder"
    set {sL, sT, sR, sB} to bounds of window of desktop
end tell
tell application "Terminal"
    activate
    do script "bash $SETUP"
    delay 0.5
    set bounds of front window to {sL, sT, sR, sB}
end tell
APPLESCRIPT
