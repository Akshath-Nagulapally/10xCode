#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORK_DIR="$PWD"
INSTR="$SCRIPT_DIR/initial_instructions.md"
SESSION="10x_$(basename "$WORK_DIR")"
N=2

# Parse --N flag (e.g. --8, --10)
for arg in "$@"; do
    if [[ "$arg" =~ ^--([0-9]+)$ ]]; then
        N="${BASH_REMATCH[1]}"
    fi
done

# Kill existing session for this project if it exists
tmux kill-session -t "$SESSION" 2>/dev/null || true

# Create new session rooted in the project directory
tmux new-session -d -s "$SESSION" -c "$WORK_DIR"

# Create N-1 additional panes, all in the project directory
for i in $(seq 1 $((N-1))); do
    tmux split-window -d -t "$SESSION" -c "$WORK_DIR"
done

# Apply layout: 2 panes stacked, otherwise tiled (square grid)
if [ "$N" -eq 2 ]; then
    tmux select-layout -t "$SESSION" even-vertical
elif [ "$N" -gt 2 ]; then
    tmux select-layout -t "$SESSION" tiled
fi

# Launch claude in each pane with instructions piped as initial prompt
for i in $(seq 0 $((N-1))); do
    tmux send-keys -t "$SESSION:0.$i" "claude < \"$INSTR\"" Enter
done

tmux attach-session -t "$SESSION"
