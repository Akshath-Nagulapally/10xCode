#!/bin/bash
set -e

# Resolve symlink to find the real script location
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
    DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"

source "$SCRIPT_DIR/lib/worktree_helpers.sh"

WORK_DIR="$PWD"
SESSION="10x_$(basename "$WORK_DIR")"
N=2

# Parse flags
for arg in "$@"; do
    if [[ "$arg" =~ ^--([0-9]+)$ ]]; then
        N="${BASH_REMATCH[1]}"
    elif [[ "$arg" == "--help" || "$arg" == "-h" ]]; then
        echo ""
        echo "Usage: 10xCode [--N]"
        echo ""
        echo "Launch N Claude agents in a tmux grid, each working in an isolated git worktree."
        echo ""
        echo "Options:"
        echo "  --2    2 agents, stacked vertically (default)"
        echo "  --4    4 agents in a 2x2 grid"
        echo "  --8    8 agents in a 3x3 grid"
        echo "  --9    9 agents in a 3x3 grid"
        echo "  --10   10 agents in a 4x3 grid"
        echo "  -h, --help  Show this help message"
        echo ""
        echo "Requirements: tmux, claude (Claude Code CLI), git repo in current directory"
        echo ""
        echo "Configuration:"
        echo "  Edit initial_instructions.md in the 10xCode install directory to change"
        echo "  what each agent does on startup."
        echo ""
        echo "Session management:"
        echo "  Detach:     Ctrl+b d"
        echo "  Kill:       tmux kill-session -t 10x_<project>"
        echo ""
        exit 0
    fi
done

# Require a git repo
if ! git -C "$WORK_DIR" rev-parse --git-dir > /dev/null 2>&1; then
    echo ""
    echo "10xCode requires a git repository. Initialize one first:"
    echo ""
    echo "  git init && git add . && git commit -m 'initial commit'"
    echo ""
    exit 1
fi

# Copy instructions to /tmp so the path is always known inside the new window
INSTR_TMP="/tmp/10xcode_instructions.md"
cp "$SCRIPT_DIR/initial_instructions.md" "$INSTR_TMP"

WORKTREE_BASE="/tmp/10xcode_${SESSION}"
mkdir -p "$WORKTREE_BASE"

git -C "$WORK_DIR" worktree prune 2>/dev/null || true

# Determine effective agent count:
#   - If existing worktrees > N: use all existing (ignore N)
#   - If existing worktrees < N: open all existing + create the difference
#   - If no existing worktrees: create N new ones
EXISTING_MAX=$(find_max_agent_number "$WORKTREE_BASE")
EFFECTIVE_N=$(compute_effective_n "$EXISTING_MAX" "$N")

if [ "$EXISTING_MAX" -gt 0 ]; then
    if [ "$N" -le "$EXISTING_MAX" ]; then
        echo ""
        echo "Found $EXISTING_MAX existing worktree(s) — opening all $EXISTING_MAX."
        echo "You requested $N. To open more, run: 10xCode --$((EXISTING_MAX + 1)) (or higher)"
        echo ""
    else
        echo ""
        echo "Found $EXISTING_MAX existing worktree(s) — reusing them and adding $((EFFECTIVE_N - EXISTING_MAX)) new one(s) to reach $EFFECTIVE_N total."
        echo ""
    fi
fi

# Create any missing worktrees up to EFFECTIVE_N
for i in $(seq 1 "$EFFECTIVE_N"); do
    BRANCH="10x_agent_${i}"
    WTREE="$WORKTREE_BASE/agent_${i}"
    if [ ! -d "$WTREE" ]; then
        git -C "$WORK_DIR" worktree add -b "$BRANCH" "$WTREE" HEAD 2>/dev/null || \
        git -C "$WORK_DIR" worktree add "$WTREE" "$BRANCH"
    fi
    # Pre-register the worktree path with Claude so it skips the trust prompt
    ENCODED=$(echo "$WTREE" | sed 's|/|-|g')
    mkdir -p "$HOME/.claude/projects/${ENCODED}"
done

# Write a temp script that will run inside the new Terminal window
SETUP="/tmp/10xcode_${SESSION}.sh"
cat > "$SETUP" << SETUP_EOF
#!/bin/bash
tmux kill-session -t "$SESSION" 2>/dev/null || true
sleep 1
tmux new-session -d -s "$SESSION" -c "$WORKTREE_BASE/agent_1" -x 220 -y 50
tmux set-option -t "$SESSION" mouse on

for i in \$(seq 2 $EFFECTIVE_N); do
    tmux split-window -d -t "$SESSION" -c "$WORKTREE_BASE/agent_\$i"
done

if [ $EFFECTIVE_N -eq 2 ]; then
    tmux select-layout -t "$SESSION" even-vertical
elif [ $EFFECTIVE_N -gt 2 ]; then
    tmux select-layout -t "$SESSION" tiled
fi

for i in \$(seq 0 $((EFFECTIVE_N-1))); do
    tmux send-keys -t "$SESSION:0.\$i" "claude --dangerously-skip-permissions < \"$INSTR_TMP\"" Enter
done

tmux attach-session -t "$SESSION"
SETUP_EOF
chmod +x "$SETUP"

# Open a new fullscreen Terminal window and run the setup inside it
osascript << APPLESCRIPT
tell application "Terminal"
    activate
    do script "bash $SETUP"
    delay 0.5
    set zoomed of front window to true
end tell
APPLESCRIPT
